# Compose-level secrets for the production stack — copy to .env next to
# docker-compose.yml and fill in. NEVER reuse legacy values (old JWT secret,
# csebdb, the old Gmail app password are all burned).

# Host port nginx publishes; Apache's vhost proxies the domain here.
PORT=3000

# MySQL 8 container. Generate both: openssl rand -hex 16
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Generate: openssl rand -hex 32
JWT_SECRET_KEY=

# Password-reset mail (rotate the Gmail app password first)
ADMIN_EMAIL=webmaster.cse@nith.ac.in
ADMIN_EMAIL_PASSWORD=
RESET_LINK_BASE=https://cse.nith.ac.in/reset-password

# Flip to true once the frontend sends Authorization headers on writes
REQUIRE_AUTH_WRITES=false
CORS_ORIGIN=*
