# Compose-level configuration & secrets for the production stack.
# Copy this file to .env next to docker-compose.yml and fill in values.
# NEVER commit .env to version control.

# ------------------------------------------------------------------------------
# PORT CONFIGURATION
# ------------------------------------------------------------------------------
# Host port published by the container stack's internal nginx proxy.
# Host Nginx forwards tempcse.nith.ac.in -> http://127.0.0.1:PORT
#
# IMPORTANT: DO NOT USE the following ports on the server (already in use):
# 8080, 5173, 8000, 8001
PORT=3000

# ------------------------------------------------------------------------------
# DATABASE CREDENTIALS (MySQL 8 Container)
# ------------------------------------------------------------------------------
# Generate strong secrets: openssl rand -hex 16
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=

# ------------------------------------------------------------------------------
# EMAIL / PASSWORD RESET CONFIGURATION
# ------------------------------------------------------------------------------
ADMIN_EMAIL=webmaster.cse@nith.ac.in
ADMIN_EMAIL_PASSWORD=
RESET_LINK_BASE=https://tempcse.nith.ac.in/reset-password

# ------------------------------------------------------------------------------
# SECURITY & CORS
# ------------------------------------------------------------------------------
REQUIRE_AUTH_WRITES=false
CORS_ORIGIN=*

