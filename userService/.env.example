# Server
BACKEND_PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

# Database (clean schema — see /schema-design)
DB_NAME=cse_department
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_LOGGING=false

# Auth
JWT_SECRET_KEY=change-me
EXPIRES_IN=1h
# Flip to true once the frontend sends Authorization headers on write requests
REQUIRE_AUTH_WRITES=false

# Mail (password reset)
ADMIN_EMAIL=
ADMIN_EMAIL_PASSWORD=
RESET_LINK_BASE=https://cse.nith.ac.in/reset-password

# PDF conversion
LIBREOFFICE_PATH=/usr/bin/soffice
